{
  "name": "@productengineered/wapentake",
  "version": "0.3.0",
  "description": "Local, durable conversations for humans and coding agents",
  "type": "module",
  "private": true,
  "os": [
    "darwin"
  ],
  "engines": {
    "node": ">=24.20.0 <25 || >=26.0.0 <27"
  },
  "bin": {
    "wapentake": "bin/wapentake.mjs"
  },
  "exports": {
    ".": "./src/room.mjs",
    "./worker": "./src/worker.mjs",
    "./adapters": "./src/adapters/index.mjs",
    "./models": "./src/models.mjs"
  },
  "files": [
    "bin",
    "src",
    "web",
    "migrations",
    "schemas",
    "prompts",
    "integrations",
    "examples",
    "scripts",
    "README.md",
    "CHANGELOG.md",
    "docs"
  ],
  "scripts": {
    "test": "node --import ./tests/isolate-config.mjs --test --test-concurrency=1 tests/*.test.mjs",
    "start": "node bin/wapentake.mjs serve --operator",
    "doctor": "node bin/wapentake.mjs doctor --offline --operator",
    "install:local": "node scripts/install-local.mjs",
    "lint": "eslint .",
    "check:quality": "node .github/scripts/quality.mjs",
    "check:package": "node .github/scripts/package.mjs",
    "check:secrets": "python3 .github/scripts/secrets.py --history",
    "setup:hooks": "python3 .github/scripts/tools.py gitleaks && git config --local core.hooksPath .githooks"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/productengineered/wapentake.git"
  },
  "devDependencies": {
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "playwright": "1.63.0",
    "yaml": "2.9.0"
  }
}
